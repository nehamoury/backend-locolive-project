# ==========================================
# LocoLive Backend — Production Environment
# ==========================================
# ⚠️ NEVER commit this file to version control
# ⚠️ Rotate ALL secrets before production deployment

# Database (use dedicated production user, NOT postgres superuser)
DB_DRIVER=postgres
DB_SOURCE=postgresql://locolive:YOUR_STRONG_DB_PASSWORD@127.0.0.1:5432/privacy_social?sslmode=disable

# Server
SERVER_ADDRESS=0.0.0.0:8080

# Redis (set requirepass in redis.conf)
REDIS_ADDRESS=redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6379

# JWT (generate a strong 64-char random string)
JWT_SECRET=YOUR_64_CHARACTER_STRONG_SECRET_KEY_HERE_DO_NOT_USE_DEFAULT
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=24h

# Google OAuth (create production credentials in Google Console)
GOOGLE_CLIENT_ID=YOUR_PROD_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_PROD_GOOGLE_CLIENT_SECRET

# Cloudflare R2 / S3 Storage
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY=YOUR_R2_ACCESS_KEY
R2_SECRET_KEY=YOUR_R2_SECRET_KEY
R2_BUCKET_NAME=locolive
R2_PUBLIC_URL=https://pub-XXXXXX.r2.dev

# Email (use Gmail App Password, NOT account password)
EMAIL_SENDER_NAME=Locolive
EMAIL_SENDER_ADDRESS=your-email@gmail.com
EMAIL_SENDER_PASSWORD=YOUR_16_DIGIT_GMAIL_APP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Frontend URL (your production domain)
FRONTEND_URL=https://your-domain.com

# Environment
ENVIRONMENT=production
FORCE_HTTPS=true

# Firebase (push notifications)
FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json

# TLS (optional if using nginx reverse proxy)
# TLS_CERT_FILE=./certs/fullchain.pem
# TLS_KEY_FILE=./certs/privkey.pem

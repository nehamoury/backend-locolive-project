# ==========================================
# LocoLive Backend — Environment Configuration
# ==========================================
# ⚠️ NEVER commit real credentials to version control
# ⚠️ Copy this file to app.env and fill in your values

# Database
DB_DRIVER=postgres
DB_SOURCE=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/privacy_social?sslmode=disable

# Server
SERVER_ADDRESS=0.0.0.0:8080

# Redis
REDIS_ADDRESS=redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6379

# JWT
JWT_SECRET=YOUR_64_CHARACTER_RANDOM_SECRET_KEY_HERE
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=2160h

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Cloudflare R2 / S3 Storage
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY=YOUR_R2_ACCESS_KEY
R2_SECRET_KEY=YOUR_R2_SECRET_KEY
R2_BUCKET_NAME=locolive
R2_PUBLIC_URL=https://pub-XXXXXX.r2.dev

# Email
EMAIL_SENDER_NAME=Locolive
EMAIL_SENDER_ADDRESS=your-email@gmail.com
EMAIL_SENDER_PASSWORD=YOUR_GMAIL_APP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Frontend URL
FRONTEND_URL=https://your-domain.com

# Environment
ENVIRONMENT=development
FORCE_HTTPS=false

# Firebase
FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json

# TLS (optional if using nginx)
# TLS_CERT_FILE=./certs/fullchain.pem
# TLS_KEY_FILE=./certs/privkey.pem
